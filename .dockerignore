# ============================================================
# Bansil Books — Docker Build Exclusions
# ============================================================

# Dependencies (reinstalled in container)
node_modules
npm-debug.log*

# Next.js build output (rebuilt in container)
.next
out
build

# Local data (databases, tokens — NEVER bake into image)
data/
*.db
*.db-wal
*.db-shm
*.sqlite
*.sqlite-wal
*.sqlite-shm
.tokens.json
.tokens*.json

# Environment files (secrets set via Render dashboard)
.env*

# Version control
.git
.gitignore

# IDE / OS
.DS_Store
.vscode
.idea
*.swp
*.swo

# Development artifacts
scratch/
coverage/
debug_test.log
next-dev.log
server.log
*.log
test-results*.txt

# Documentation (not needed at runtime)
*.md
ChatGPT-Project-Handoff.md
Claude\ outputs/
PRODUCTION-FIX-REPORT*.md

# Development scripts
scripts/
_run-build.command

# Quarantine / not required
Not\ Required/

# Vercel (not used on Render)
.vercel

# Security audit logs
.security-audit.log

# Large data dumps
purchase_universe.json
sales_universe.json
evidence_*.json
coa.json
fy*.json
schemas.json
